# Copy selected lines into functions/.env for emergency Firestore cost control.
# Then deploy affected functions.

# 1) Throttle ingest commits per sensor instance (seconds)
INGEST_MIN_INTERVAL_SECONDS=20

# 2) Disable non-essential high-volume writes
DISABLE_SENSOR_HISTORY_WRITES=true
DISABLE_RELAY_SERIES_WRITES=true
DISABLE_RELAY_HISTORY_WRITES=true
DISABLE_PLUG_DECISION_LOG=true
DISABLE_PLUG_STATE_HISTORY_WRITES=true

# 3) Shorten retention and cap delete bursts
SENSOR_HISTORY_RETENTION_DAYS=7
PLUG_LOG_RETENTION_DAYS=14
CLEANUP_MAX_DELETES_PER_RUN=5000

# 4) TTL integration flags
# Keep ENABLE_EXPIREAT_TTL_WRITES=true so new docs get expireAt.
# Turn these to true only after Firestore TTL is enabled on expireAt in console.
ENABLE_EXPIREAT_TTL_WRITES=true
TTL_SENSOR_COLLECTIONS_ENABLED=false
TTL_PLUG_LOG_COLLECTIONS_ENABLED=false
