INGEST_API_KEY=capstone-iaq-2026-secure-key

# Conservative Firestore cost-control mode
INGEST_MIN_INTERVAL_SECONDS=0
DISABLE_SENSOR_HISTORY_WRITES=false
DISABLE_RELAY_SERIES_WRITES=false
DISABLE_RELAY_HISTORY_WRITES=false
DISABLE_PLUG_DECISION_LOG=false
DISABLE_PLUG_STATE_HISTORY_WRITES=false
SENSOR_HISTORY_RETENTION_DAYS=30
PLUG_LOG_RETENTION_DAYS=90
CLEANUP_MAX_DELETES_PER_RUN=8000

# Write expireAt field for Firestore TTL policies
ENABLE_EXPIREAT_TTL_WRITES=true

# Set true only after enabling Firestore TTL on expireAt for those collections
TTL_SENSOR_COLLECTIONS_ENABLED=true
TTL_PLUG_LOG_COLLECTIONS_ENABLED=true

# Capstone Tasmota MQTT remote control
MQTT_URL=mqtts://7d18e3d75dbb4d12aa5951049f5868d2.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=Capstone
MQTT_PASSWORD=Capstone1
ENABLE_FUNCTION_MQTT_COMMANDS=true
FUNCTION_MQTT_ACK_TIMEOUT_MS=8000
